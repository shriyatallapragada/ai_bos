# LLM provider: auto | ollama | groq | none
#   auto = Groq if GROQ_API_KEY is set, else local Ollama if running, else deterministic rules engine
LLM_PROVIDER=auto

# Groq (hosted open-source models; free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local): `ollama serve` then `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# DB_PATH=data/aibos.db
# CORS_ORIGINS=http://localhost:5173
# MAX_TOOL_ROUNDS=6
# LLM_TIMEOUT=90
